        }
      },
      {
        "id": "CL-HT-5",
        "clause_no": "第 5 条",
        "section": "五、交货与验收",
        "page": 2,
        "text": "交货期 2024-03-30；逾期按合同总额每日 0.5‰ 计罚。验收按技术协议及国家现行标准执行。",
        "type": "commercial",
