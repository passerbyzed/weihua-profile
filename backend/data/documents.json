[
  {
    "id": "DOC-TA-LD5-2024-0316-01",
    "type": "技术协议",
    "type_code": "TA",
    "title": "LD5-2024-0316 电动单梁起重机技术协议",
    "doc_no": "JSXY-2024-0316",
    "version": "v1.2",
    "machine_id": "LD5-2024-0316",
    "contract_no": "HT-2024-0316",
    "effective_date": "2024-02-20",
    "status": "生效",
    "pages": 9,
    "file_name": "LD5-2024-0316 技术协议 v1.2.pdf",
    "summary": "含整机参数、钢板材质与板厚、配套件、电气、涂装、检验等条款",
    "clauses": [
      {
        "id": "CL-TA-3.1",
        "clause_no": "3.1",
        "section": "3 整机主要技术参数",
        "page": 3,
        "text": "额定起重量 5 t，跨度 10.5 m，起升高度 9 m，工作级别 A5。",
        "type": "parameter",
        "components": ["整机"],
        "values": {
          "capacity": { "value": 5, "unit": "t", "text": "额定起重量 5 t" },
          "span": { "value": 10.5, "unit": "m", "text": "跨度 10.5 m" }
        }
      },
      {
        "id": "CL-TA-4.1",
        "clause_no": "4.1",
        "section": "4 主要钢结构件材质与板厚 › 4.1 材质与板厚明细",
        "page": 4,
        "text": "主梁上翼缘板采用 Q355B，板厚 25 mm；厚度负偏差不大于 0.25 mm；厚度不小于 20 mm 的钢板按 GB/T 2970 进行超声检测，质量等级不低于Ⅰ级。",
        "type": "material",
        "components": ["主梁"],
        "values": {
          "steel_flange": { "value": 25, "unit": "mm", "text": "主梁上翼缘板厚 25 mm" },
          "steel_deviation": { "value": 0.25, "unit": "mm", "text": "厚度负偏差不大于 0.25 mm" },
          "steel_ut": { "value": "Ⅰ级", "text": "超声检测质量等级不低于Ⅰ级" }
        }
      },
      {
        "id": "CL-TA-5.8",
        "clause_no": "5 配套件配置表 序号 8",
        "section": "5 主要配套件配置",
        "page": 4,
        "text": "吊钩：锻造 35CrMo，GB/T 10051.1，带闭锁装置，供货时提供开口度检测记录。",
        "type": "component",
        "components": ["吊钩组"],
        "values": {
          "hook_material": { "value": "锻造 35CrMo", "text": "吊钩锻造 35CrMo" },
          "hook_lock": { "value": "带闭锁装置", "text": "带闭锁装置" },
          "hook_doc": { "value": "提供开口度检测记录", "text": "提供开口度检测记录" }
        }
      },
      {
        "id": "CL-TA-6.4",
        "clause_no": "6.4",
        "section": "6 电气与控制系统",
        "page": 5,
        "text": "电气柜防护等级 IP65，柜内设加热除湿装置，适应食品车间潮湿环境。",
        "type": "parameter",
        "components": ["电控柜"],
        "values": {
          "cabinet_ip": { "value": "IP65", "text": "电气柜防护等级 IP65" }
        }
      },
      {
        "id": "CL-TA-8.1.2",
        "clause_no": "8.1.2",
        "section": "8 涂装、包装与运输 › 8.1 表面处理与涂层",
        "page": 6,
        "text": "涂层体系及干膜厚度见下表，总干膜厚度不低于 240 μm（本项目室内环境亦按 240 μm 执行）；耐盐雾 720 h 不起泡、不生锈。",
        "type": "coating",
        "components": ["涂装层"],
        "values": {
          "paint_dft": { "value": 240, "unit": "μm", "text": "总干膜厚度不低于 240 μm" },
          "paint_salt": { "value": 720, "unit": "h", "text": "耐盐雾 720 h" }
        }
      },
      {
        "id": "CL-TA-8.1.3",
        "clause_no": "8.1.3",
        "section": "8 涂装、包装与运输 › 8.1 表面处理与涂层",
        "page": 6,
        "text": "面漆颜色按需方要求（海灰色 RAL7035）；涂层应均匀、无流挂、无起泡、无漏涂，附着力不低于 1 级。",
        "type": "coating",
        "components": ["涂装层"],
        "values": {
          "paint_color": { "value": "海灰色 RAL7035", "text": "面漆颜色为海灰色 RAL7035" },
          "paint_prep": { "value": "Sa2.5", "text": "涂装前表面处理 Sa2.5" }
        }
      },
      {
        "id": "CL-TA-8.1.4",
        "clause_no": "8.1.4",
        "section": "8 涂装、包装与运输 › 8.1 表面处理与涂层",
        "page": 6,
        "text": "涂装体系按食品车间潮湿、每日冲洗环境设计，底漆采用环氧富锌底漆，中间漆环氧云铁，面漆丙烯酸聚氨酯。",
        "type": "coating",
        "components": ["涂装层"],
        "values": {}
      },
      {
        "id": "CL-TA-9.2",
        "clause_no": "9.2",
        "section": "9 试验与验收",
        "page": 7,
        "text": "出厂验收按本协议第 4.1 条实测板厚，每台抽查不少于 20 点；涂层厚度按第 8.1.2 条检测。",
        "type": "inspection",
        "components": ["主梁", "涂装层"],
        "values": {}
      }
    ]
  },
